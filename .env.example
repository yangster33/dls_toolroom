# 复制本文件为 .env 后按需修改（.env 不入库，勿提交）
#
# ⚠️ 所有变量都有代码内默认值，不设 .env 也能正常构建，
#    这样 CI 产物与本地保持一致。

# 是否开启"势"tab（展示DlsMoment.vue）
# 默认：开（代码里只有显式 false 才关闭）。设为 false 可关闭。
# VITE_ENABLE_MOMENT_TAB=true

# 是否启用 Mock API（开发时）
# true - 使用本地 mock 数据，无需后端
# false - 请求代理到 Django 后端 (localhost:8000，见 vite.config.ts 的 proxy）
# 默认：false
# VITE_USE_MOCK=false

# 站点 URL（用于 prerender 生成 sitemap，以及 SEO 的 canonical/og:url）
# 默认：https://dlslab.cn
# VITE_SITE_URL=https://dlslab.cn

# 百度统计站点 ID（hm.js? 后面那串），默认使用已申请的内置 ID。
# 设为空字符串可彻底关闭统计。
# 只有 VITE_SITE_URL 对应的域名（含子域名）才会真正加载脚本，
# 因此 dev / Vercel 预览域名 / prerender 的本地服务都不会污染统计数据。
# VITE_BAIDU_HM_ID=855d5ff9879a97b2b1d3e30dea692a31

# 外部 API 是否走同源反向代理 /proxy/*（见 src/utils/apiProxy.ts）
# 默认：生产 + dlslab.cn 域名自动开启；开发/Vercel 预览域名直连。
# true  - 强制走代理（本地联调 nginx 时用）
# false - 强制直连
# VITE_API_PROXY=true
